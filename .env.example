# Merchku env example
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me
APP_NAME=merchku
ENV=dev

DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=merchku
DB_PASSWORD=change-this-password
DB_NAME=merchku
SQLALCHEMY_DATABASE_URI=

LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

TRUSTED_PROXIES=127.0.0.1/32,::1/128

SECURE_COOKIES=0

METRICS_TOKEN=change-metrics-token

UPLOAD_PUBLIC=uploads/public
UPLOAD_PRIVATE=uploads/private
MAX_CONTENT_LENGTH=16777216

RATE_LIMIT_DEFAULT="200 per minute"

# Biteship shipping rates (optional until API key and store origin are ready)
BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com
SHIPPING_ORIGIN_POSTAL_CODE=
CHECKOUT_SERVICE_FEE_RP=0
CHECKOUT_SHIPPING_DISCOUNT_RP=0
FRAGILE_PACKING_FEE_RP=0

# Midtrans Snap (use sandbox Server Key during development)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=0

# Customer Service AI (opsional). Tanpa key, CS tetap menjawab otomatis
# memakai data toko. Isi key dari console.anthropic.com untuk jawaban Claude,
# lalu jalankan: pip install anthropic
ANTHROPIC_API_KEY=
CS_AI_MODEL=claude-haiku-5-5
