# Merchku env example
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me
APP_NAME=merchku
ENV=dev

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=merchku
DB_PASSWORD=merchku
DB_NAME=merchku
SQLALCHEMY_DATABASE_URI=sqlite:///merchku.db

LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

TRUSTED_PROXIES=127.0.0.1/32,::1/128

SECURE_COOKIES=0

METRICS_TOKEN=change-metrics-token

UPLOAD_PUBLIC=uploads/public
UPLOAD_PRIVATE=uploads/private
MAX_CONTENT_LENGTH=16777216

RATE_LIMIT_DEFAULT="200 per minute"
