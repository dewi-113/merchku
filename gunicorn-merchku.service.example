# /etc/systemd/system/merchku.service example
[Unit]
Description=Merchku Gunicorn
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/merchku
EnvironmentFile=/opt/merchku/.env
ExecStart=/usr/bin/env gunicorn -w 4 -b 127.0.0.1:8000 run:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
